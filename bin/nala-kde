#!/usr/bin/env bash
set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
root=$(cd -- "$here/.." && pwd)

if command -v kpackagetool6 >/dev/null && command -v kwriteconfig6 >/dev/null; then
  package=$root/kwin/nala-cursor
  installed=${XDG_DATA_HOME:-$HOME/.local/share}/kwin/scripts/nala-cursor
  if [ -d "$installed" ]; then
    kpackagetool6 --type=KWin/Script --upgrade "$package" >/dev/null
  else
    kpackagetool6 --type=KWin/Script --install "$package" >/dev/null
  fi
  kwriteconfig6 --file kwinrc --group Plugins --key nala-cursorEnabled true
  qdbus-qt6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
fi

export QT_QPA_PLATFORM=xcb
exec "${NALA:-$root/build/nala}" "$@"
